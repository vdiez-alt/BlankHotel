---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, u } from '../config';

interface Props {
  title: string;
  description: string;
  /** Header con fondo sólido desde el inicio (páginas sin foto de portada). */
  solid?: boolean;
  image?: string;
  jsonld?: object | object[];
}
const { title, description, solid = false, image = 'hero-home.jpg', jsonld } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(u(`images/${image}`), Astro.site);
const fullTitle = title.includes('Blank') ? title : `${title} | ${SITE.name}`;
---
<!doctype html>
<html lang="es-AR" data-base={u('')}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#10100F" />
    <link rel="icon" href={u('images/logo-blank-hotel-recoleta.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <Header solid={solid} />
    <main id="contenido"><slot /></main>
    <Footer />
    <div class="toast" role="status" aria-live="polite"><span></span><a href={u('carrito')}>Ver carrito</a></div>
    <div class="cursor-ring" aria-hidden="true" transition:persist="cursor-ring"></div>
    <div class="cursor-dot" aria-hidden="true" transition:persist="cursor-dot"></div>
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
