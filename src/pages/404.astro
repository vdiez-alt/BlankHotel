---
import Base from '../layouts/Base.astro';
import { u } from '../config';
---
<Base title="Página no encontrada" description="La página que buscás no existe." solid>
  <section class="page-top sec" style="min-height:80vh">
    <div class="wrap">
      <p class="eyebrow">Error 404</p>
      <h1 class="h1" style="margin:30px 0">Esta página<br /><em>no existe.</em></h1>
      <div class="room__acts" style="margin-top:40px"><a class="btn btn--dark" href={u('')}><span>Volver al inicio</span></a><a class="link" href={u('spa')}>Descubrir el Spa</a></div>
    </div>
  </section>
</Base>
